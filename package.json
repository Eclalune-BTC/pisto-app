{
  "name": "pisto-stack",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.19.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "brace-expansion": "5.0.12",
    "compression": "1.8.2",
    "decode-uri-component": "0.5.1",
    "follow-redirects": "1.16.2",
    "node-forge": "1.4.3",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "vite": "8.2.4"
  },
  "scripts": {
    "setup": "bun run scripts/pisto.ts init",
    "doctor": "bun run scripts/pisto.ts doctor",
    "smoke:local": "bun run scripts/smoke-local.ts",
    "test:e2e": "playwright test",
    "db:seed": "bun --env-file=.env run scripts/seed.ts",
    "dev": "turbo run dev",
    "dev:app": "bun run --filter @pisto/app dev",
    "dev:api": "bun --env-file=.env --watch scripts/dev-api.ts",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "bun test ./scripts && turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "docs:check": "bun run scripts/validate-docs.ts",
    "audit:ci": "bun audit --ignore GHSA-67mh-4wv8-2f99 --ignore GHSA-w3rx-r6r6-pgpr --ignore GHSA-5p2g-fcmc-qvqq --ignore GHSA-w5hq-g745-h8pq --ignore GHSA-mrhx-c7xc-m3w5 --ignore GHSA-3g3m-2fjr-6pw4 --ignore GHSA-g3hv-75wg-m249 --ignore GHSA-gcqx-w48m-w2h4",
    "check": "bun run lint && bun run docs:check && bun test ./scripts && turbo run typecheck test && bun run build",
    "verify": "bun run doctor && bun run check && bun run test:integration",
    "test:integration": "bun --env-file=.env run --filter @pisto/db test:integration && bun --env-file=.env run --filter @pisto/billing test:integration",
    "db:generate": "bun --env-file=.env run --filter @pisto/db db:generate",
    "db:migrate": "bun --env-file=.env run --filter @pisto/db db:migrate",
    "db:push": "bun --env-file=.env run --filter @pisto/db db:push",
    "db:check": "bun --env-file=.env run --filter @pisto/db db:check",
    "db:studio": "bun --env-file=.env run --filter @pisto/db db:studio",
    "auth:schema:check": "bun run --filter @pisto/auth auth:schema:check",
    "auth:schema:generate": "bun --env-file=.env run --filter @pisto/auth auth:schema:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "1.64.1",
    "turbo": "2.10.11",
    "typescript": "6.0.3"
  },
  "patchedDependencies": {
    "query-string@7.1.3": "patches/query-string@7.1.3.patch"
  }
}
