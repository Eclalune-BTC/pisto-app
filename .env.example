# Local Pisto Stack server and Docker Compose configuration.
# Copy with `bun run setup`; never commit the generated .env file.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
API_REQUEST_BODY_LIMIT_BYTES=1048576

POSTGRES_USER=pisto
POSTGRES_PASSWORD=pisto_local_only
POSTGRES_DB=pisto
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pisto:pisto_local_only@localhost:5432/pisto
DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_IDLE_TIMEOUT_SECONDS=20
DATABASE_SSL=disable

# `bun run setup` replaces this placeholder with a cryptographically random value.
BETTER_AUTH_SECRET=__GENERATED_BETTER_AUTH_SECRET__
BETTER_AUTH_SECRETS=
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
TRUSTED_ORIGINS=http://localhost:8081,http://localhost:19006,pisto://
EXPO_SCHEME=pisto
AUTH_EMAIL_PASSWORD_ENABLED=true
AUTH_TRUSTED_PROXY_HEADERS=false

# Polar is the browser billing provider. Start disabled and use sandbox first.
BILLING_ENABLED=false
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
POLAR_PRODUCTS_JSON=
POLAR_SUCCESS_URL=http://localhost:8081/billing/success
POLAR_RETURN_URL=http://localhost:8081/billing
POLAR_THEME=light

# RevenueCat receives native App Store and Play events. It is disabled by default.
REVENUECAT_ENABLED=false
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_SIGNATURE_TOLERANCE_SECONDS=300
REVENUECAT_ENTITLEMENT_MAP_JSON=
