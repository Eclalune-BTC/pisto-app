# Keep the working tree byte-identical on every platform.
# Without this, core.autocrlf=true checks Windows clones out with CRLF while
# .editorconfig and the Biome formatter expect LF, so `bun run check` fails
# locally on files nobody edited.
* text=auto eol=lf

# Lockfiles and generated SQL are text but must never be re-wrapped.
bun.lock text eol=lf
*.sql text eol=lf

# Binary assets must not be transformed at all.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
