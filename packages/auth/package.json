{
  "name": "@pisto/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --packages external",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "auth:schema:check": "bun ./src/check-schema.ts",
    "auth:schema:generate": "better-auth generate --config ./src/cli.ts --output ./.generated/better-auth-schema.ts --yes"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.1",
    "@pisto/billing": "workspace:*",
    "@pisto/db": "workspace:*",
    "better-auth": "1.7.1",
    "drizzle-orm": "0.45.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "auth": "1.7.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
