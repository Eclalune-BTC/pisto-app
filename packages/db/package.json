{
  "name": "@pisto/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --packages external",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:integration": "bun test ./integration/product.integration.ts ./integration/catalog.integration.ts ./integration/cash.integration.ts ./integration/receivables.integration.ts",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "bun ./src/migrate.ts",
    "db:check": "drizzle-kit check --config ./drizzle.config.ts",
    "db:push": "drizzle-kit push --config ./drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config ./drizzle.config.ts"
  },
  "dependencies": {
    "@pisto/contracts": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "drizzle-kit": "0.31.10",
    "temporal-spec": "1.0.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
