{
  "name": "@pisto/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --watch ../../scripts/dev-api.ts",
    "start": "bun ./src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --packages external",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.2",
    "@pisto/auth": "workspace:*",
    "@pisto/billing": "workspace:*",
    "@pisto/contracts": "workspace:*",
    "@pisto/db": "workspace:*",
    "@sinclair/typebox": "0.34.52",
    "drizzle-orm": "0.45.2",
    "elysia": "1.4.30",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
